{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captcf.fr/schemas/stt-benchmark-result-v1.json",
  "title": "CapTCF STT benchmark canonical result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "model", "audio_id", "language", "latency_ms", "estimated_cost_usd", "text", "segments"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "audio_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "text": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speaker", "start_ms", "end_ms", "text", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "speaker": { "type": ["string", "null"] },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
