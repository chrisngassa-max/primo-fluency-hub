{
  "version": "1.0",
  "scoring_rules": [
    { "id": "SCORE_01", "condition": "exercise.theme_id == session.theme_id", "points": 40, "reason": "Thème parfaitement aligné" },
    { "id": "SCORE_02", "condition": "exercise.domaine_irn == session.domaine_irn", "points": 15, "reason": "Même domaine IRN" },
    { "id": "SCORE_03", "condition": "exercise.niveau_cecrl == student.niveau_cecrl", "points": 20, "reason": "Niveau exact" },
    { "id": "SCORE_04", "condition": "exercise.niveau_cecrl == (student.niveau_cecrl - 1)", "points": 10, "reason": "Niveau inférieur toléré pour révision" },
    { "id": "SCORE_05", "condition": "exercise.mode_cible == student.mode", "points": 15, "reason": "Mode d'apprentissage aligné" },
    { "id": "SCORE_06", "condition": "exercise.erreur_cible_id == student.dominantErrorType", "points": 25, "reason": "Cible l'erreur fréquente de l'étudiant" },
    { "id": "SCORE_07", "condition": "student.mode == 'remediation' AND exercise.etayage == 'fort'", "points": 15, "reason": "Étayage adapté à la remédiation" },
    { "id": "SCORE_08", "condition": "student.mode == 'augmente' AND exercise.etayage == 'faible'", "points": 15, "reason": "Étayage adapté à l'augmentation" },
    { "id": "SCORE_09", "condition": "exercise.competence == session.current_phase_competence", "points": 30, "reason": "Compétence requise pour la phase de la séance" },
    { "id": "SCORE_10", "condition": "exercise.pilier == student.structures_pilier_faible", "points": 20, "reason": "Cible le pilier structurel faible" },
    { "id": "SCORE_11", "condition": "session.type_demarche == 'titre_sejour' AND (exercise.competence == 'CO' OR exercise.competence == 'CE')", "points": 10, "reason": "Priorité CO/CE pour le titre de séjour" },
    { "id": "SCORE_12", "condition": "session.type_demarche == 'naturalisation' AND exercise.niveau_cecrl == 'B2'", "points": 15, "reason": "Niveau cible de la naturalisation" },
    { "id": "SCORE_13", "condition": "student.niveau_variante == 'bas' AND exercise.limite_mots_max <= 40", "points": 10, "reason": "Volume adapté à variante basse" },
    { "id": "SCORE_14", "condition": "exercise.format IN matrix.formats_autorises", "points": 10, "reason": "Format autorisé par la matrice" },
    { "id": "SCORE_15", "condition": "exercise.mots_cles IN session.lexique_noyau", "points": 5, "reason": "Renforce le lexique noyau" }
  ],
  "hard_filters": [
    { "id": "EXCL_01", "condition": "exercise.theme_id != session.theme_id", "reason": "Rupture du tronc commun thématique" },
    { "id": "EXCL_02", "condition": "exercise.format NOT IN matrix.formats_autorises", "reason": "Format pédagogiquement inadapté au niveau/mode" },
    { "id": "EXCL_03", "condition": "(exercise.competence == 'EE' OR exercise.competence == 'EO') AND exercise.limite_mots_max > 90", "reason": "Violation de la contrainte TCF IRN (max 90 mots)" },
    { "id": "EXCL_04", "condition": "student.niveau_cecrl == 'A0' AND exercise.format == 'production_ecrite'", "reason": "Public A0/NSA ne peut pas produire de texte libre" },
    { "id": "EXCL_05", "condition": "student.mode == 'remediation' AND exercise.etayage == 'faible'", "reason": "Remédiation nécessite un étayage fort ou moyen" },
    { "id": "EXCL_06", "condition": "exercise.niveau_cecrl > (student.niveau_cecrl + 1)", "reason": "Exercice beaucoup trop difficile" },
    { "id": "EXCL_07", "condition": "exercise.niveau_cecrl < (student.niveau_cecrl - 1)", "reason": "Exercice beaucoup trop facile" },
    { "id": "EXCL_08", "condition": "student.niveau_cecrl == 'A0' AND exercise.competence == 'CE' AND exercise.tache_type == 'comprehension_implicite'", "reason": "Inférence impossible au niveau A0" },
    { "id": "EXCL_09", "condition": "session.type_demarche == 'titre_sejour' AND exercise.niveau_cecrl == 'B2'", "reason": "Titre de séjour ne nécessite pas B2" },
    { "id": "EXCL_10", "condition": "student.error_id == 'CONSIGNE_NC' AND exercise.consigne_max_mots > 10", "reason": "Consigne trop longue pour un apprenant qui ne comprend pas les consignes" }
  ]
}
