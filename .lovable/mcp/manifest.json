{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://project-ref-unset.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "captcf-mcp",
      "version": "0.1.0",
      "title": "Cap CF — TCF IRN"
    },
    "tools": [
      {
        "name": "list_my_groups",
        "title": "Lister mes groupes",
        "description": "Liste les groupes actifs du formateur connecté (nom, niveau, nombre de membres).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_sessions",
        "title": "Lister mes séances",
        "description": "Liste les séances associées à l'utilisateur connecté (formateur ou élève selon RLS).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Nombre maximum de séances à retourner.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "statut": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "planifiee",
                    "en_cours",
                    "terminee",
                    "annulee"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrer par statut, ou null pour tous."
            }
          },
          "required": [
            "statut"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_my_progression",
        "title": "Ma progression",
        "description": "Retourne les derniers résultats de l'élève connecté avec score et compétence.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "Nombre de résultats récents à retourner.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
